# Build output
/target/
**/*.rs.bk

# Local databases and real (non-fixture) snapshots: never commit league data or tokens
*.db
*.db-journal
*.sqlite
/data/
/snapshots/
.env
yahoo_token*.json
oauth*.json

# Editors / OS
.idea/
.vscode/
.DS_Store

# Scraper: virtualenvs, caches and any browser profile placed in the repo by mistake.
# (Scraped snapshots and --debug-dump HTML go to /data/, ignored above.)
/scraper/.venv/
__pycache__/
*.pyc
browser-profile/
.fantasy-hoops/
